      ],
      "activities": [{
        "id": "explore",
        "title": "从点列到圆链",
        "stages": [
          { "id": "sequence", "narration": "Sequence 按 i=0…n−1 生成等角分布的圆心。调整 n，集合数量确定性变化。", "hide": ["inversion", "I", "invertedChain"] },
          { "id": "zip", "narration": "Zip/Map 把同一个圆构造应用到每个圆心，得到完整圆链。", "hide": ["inversion", "I", "invertedChain"] },
          { "id": "invert", "narration": "第二次 Zip/Map 将圆反演逐项应用到整条圆链。拖动 I 或改变 θ，像圆同步更新。" }
        ]
      }],
      "provenance": { "generator": "agent", "sourceRefs": ["geogebra:m8SXgrNh"] }
    }
  },
