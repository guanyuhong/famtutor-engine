{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://famtutor.ai/schemas/famtutor.render.bundle.v1.schema.json",
  "title": "FamTutor Render Bundle v1",
  "description": "Host delivery container for canonical domain documents, static assets, runtime compatibility requirements, entrypoint metadata, fallback SVG, and integrity hash.",
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "schema", "documentId", "revision"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "renderBundleDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "content", "digest"],
      "properties": {
        "ref": { "$ref": "#/$defs/documentRef" },
        "content": { "$ref": "#/$defs/jsonValue" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "bundleAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mediaType", "encoding", "content", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "encoding": { "type": "string", "enum": ["utf8", "base64"] },
        "content": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "renderBundleEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "mode", "mediaType"],
      "properties": {
        "renderer": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "enum": ["artifact", "mounted", "snapshot"]
        },
        "mediaType": { "type": "string", "minLength": 1 },
        "viewId": { "type": "string", "minLength": 1 },
        "stageId": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 }
      }
    },
    "renderBundleRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "documentSchema", "runtime", "renderer"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "documentSchema": { "type": "string", "minLength": 1 },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "versionRange"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "versionRange": { "type": "string", "minLength": 1 }
          }
        },
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "mode", "mediaTypes"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "mode": {
              "type": "string",
              "enum": ["artifact", "mounted", "snapshot"]
            },
            "mediaTypes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "renderBundleFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "encoding", "content", "digest"],
      "properties": {
        "mediaType": { "type": "string", "minLength": 1 },
        "encoding": { "type": "string", "enum": ["utf8", "base64"] },
        "content": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "document", "assets", "entrypoint", "requirements", "fallback", "integrity"],
  "properties": {
    "schema": { "const": "famtutor.render.bundle.v1" },
    "document": { "$ref": "#/$defs/renderBundleDocument" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/bundleAsset" }
    },
    "entrypoint": { "$ref": "#/$defs/renderBundleEntrypoint" },
    "requirements": { "$ref": "#/$defs/renderBundleRequirements" },
    "fallback": { "$ref": "#/$defs/renderBundleFallback" },
    "integrity": { "$ref": "#/$defs/digest" }
  }
}
