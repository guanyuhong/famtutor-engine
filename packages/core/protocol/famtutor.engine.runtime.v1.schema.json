{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://famtutor.ai/schemas/famtutor.engine.runtime.v1.schema.json",
  "title": "FamTutor Engine Runtime Contracts v1",
  "description": "Cross-domain wire contracts for DocumentRef, ChangeSet, Diagnostic, ValidationReport, ApplyResult, RenderRequest/Artifact/Result, RuntimeDescriptor, RuntimeEvent, InteractionAction, MountedRendererState, and RenderUpdateResult. Domain documents stay in per-domain schemas.",
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "schema", "documentId", "revision"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "suggestedFix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "operation": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "expected": { "$ref": "#/$defs/jsonValue" },
        "actual": { "$ref": "#/$defs/jsonValue" },
        "retryable": { "type": "boolean" },
        "suggestedFixes": {
          "type": "array",
          "items": { "$ref": "#/$defs/suggestedFix" }
        }
      }
    },
    "validationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": { "type": "string", "enum": ["valid", "partial", "invalid"] },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "changeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "changeSetId", "base", "operations"],
      "properties": {
        "schema": { "const": "famtutor.engine.change-set.v1" },
        "changeSetId": { "type": "string", "minLength": 1 },
        "base": { "$ref": "#/$defs/documentRef" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["op"],
            "properties": {
              "op": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "applySuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "changeSetId", "base", "next", "document", "diagnostics"],
      "properties": {
        "ok": { "const": true },
        "changeSetId": { "type": "string", "minLength": 1 },
        "base": { "$ref": "#/$defs/documentRef" },
        "next": { "$ref": "#/$defs/documentRef" },
        "document": { "$ref": "#/$defs/jsonValue" },
        "created": {
          "type": "array",
          "items": { "type": "string" }
        },
        "removed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "effects": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "applyFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "changeSetId", "base", "document", "diagnostics"],
      "properties": {
        "ok": { "const": false },
        "changeSetId": { "type": "string", "minLength": 1 },
        "base": { "$ref": "#/$defs/documentRef" },
        "document": { "$ref": "#/$defs/jsonValue" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "effects": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "renderRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "famtutor.engine.render-request.v1" },
        "renderer": { "type": "string" },
        "mediaType": { "type": "string" },
        "viewId": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "stageId": { "type": "string" },
        "options": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "renderArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "document", "renderer", "mediaType", "encoding", "content", "digest", "diagnostics"],
      "properties": {
        "schema": { "const": "famtutor.engine.render-artifact.v1" },
        "document": { "$ref": "#/$defs/documentRef" },
        "renderer": { "type": "string" },
        "mediaType": { "type": "string" },
        "encoding": { "type": "string", "enum": ["utf8", "base64"] },
        "content": { "type": "string" },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "renderResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "artifact"],
          "properties": {
            "ok": { "const": true },
            "artifact": { "$ref": "#/$defs/renderArtifact" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "diagnostics"],
          "properties": {
            "ok": { "const": false },
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "#/$defs/diagnostic" }
            }
          }
        }
      ]
    },
    "runtimeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "domain", "documentSchemas", "operationSchemas", "renderers"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "domain": { "type": "string" },
        "documentSchemas": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "operationSchemas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "renderers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mediaTypes", "modes"],
            "properties": {
              "id": { "type": "string" },
              "mediaTypes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "modes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": ["artifact", "mounted", "snapshot"]
                }
              }
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "runtimeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "eventId", "sequence", "type", "document", "timestamp"],
      "properties": {
        "schema": { "const": "famtutor.engine.runtime-event.v1" },
        "eventId": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "type": { "type": "string", "minLength": 1 },
        "document": { "$ref": "#/$defs/documentRef" },
        "timestamp": { "type": "string", "minLength": 1 },
        "target": { "type": "string" },
        "payload": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "interactionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "target": { "type": "string" },
        "payload": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "mountedRendererState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "document", "destroyed"],
      "properties": {
        "schema": { "const": "famtutor.engine.mounted-renderer-state.v1" },
        "document": { "$ref": "#/$defs/documentRef" },
        "viewId": { "type": "string" },
        "stageId": { "type": "string" },
        "selectedEntityId": { "type": "string" },
        "rendererMode": { "type": "string" },
        "camera": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        },
        "destroyed": { "type": "boolean" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "renderUpdateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "strategy", "state", "diagnostics"],
      "properties": {
        "ok": { "type": "boolean" },
        "strategy": { "type": "string", "enum": ["rebuild", "reconcile"] },
        "apply": {
          "oneOf": [
            { "$ref": "#/$defs/applySuccess" },
            { "$ref": "#/$defs/applyFailure" }
          ]
        },
        "state": { "$ref": "#/$defs/mountedRendererState" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "effects": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/documentRef" },
    { "$ref": "#/$defs/diagnostic" },
    { "$ref": "#/$defs/validationReport" },
    { "$ref": "#/$defs/changeSet" },
    { "$ref": "#/$defs/applySuccess" },
    { "$ref": "#/$defs/applyFailure" },
    { "$ref": "#/$defs/renderRequest" },
    { "$ref": "#/$defs/renderArtifact" },
    { "$ref": "#/$defs/renderResult" },
    { "$ref": "#/$defs/runtimeDescriptor" },
    { "$ref": "#/$defs/runtimeEvent" },
    { "$ref": "#/$defs/interactionAction" },
    { "$ref": "#/$defs/mountedRendererState" },
    { "$ref": "#/$defs/renderUpdateResult" }
  ]
}
