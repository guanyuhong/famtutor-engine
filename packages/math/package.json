{
  "name": "@famtutor/math-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "FamTutor Engine math domain: Agent-native 2D construction, validation, simulation, and JSXGraph/SVG runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol/document-schema": "./protocol/famtutor.math.document.v1.schema.json",
    "./protocol/agent-tools": "./protocol/famtutor.math.agent-tools.v1.json",
    "./vendor/jsxgraph/jsxgraph.css": "./vendor/jsxgraph/jsxgraph.css",
    "./vendor/jsxgraph/jsxgraphcore.js": "./vendor/jsxgraph/jsxgraphcore.js"
  },
  "bin": {
    "famtutor-math": "./bin/famtutor-math.mjs",
    "famtutor-math-mcp": "./bin/famtutor-math-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "protocol",
    "examples",
    "demo",
    "vendor/jsxgraph",
    "README.md",
    "docs",
    "TEST_REPORT.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "npm run build && node --test ./test/*.test.mjs",
    "test:schema": "npm run build && node ./scripts/schema-smoke.mjs",
    "test:browser": "npm run build && node ./scripts/browser-smoke.mjs",
    "test:mcp": "npm run build && node ./scripts/mcp-smoke.mjs",
    "test:cli": "npm run build && node ./scripts/cli-smoke.mjs",
    "benchmark": "npm run build && node ./scripts/benchmark.mjs",
    "verify": "npm run test && npm run test:schema && npm run test:browser && npm run test:mcp && npm run test:cli && node ./scripts/package-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
